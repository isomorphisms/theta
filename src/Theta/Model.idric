module Theta.Model

%default total

-- Current Edriç inherits Idris 2's host floating primitive here. Renderer
-- adapters must pack geometry and colors into 32-bit float buffers on-device.
public export
Scalar : Type
Scalar = Double

public export
record complex_value where
  constructor complex
  real : Scalar
  imaginary : Scalar

choice height_mode one_of
  modulus_height
  logarithmic_height
  real_height
  imaginary_height

choice color_mode one_of
  wegert_color
  phase_color
  height_color

choice renderer_name one_of
  three_js
  plotly_js
  babylon_js
  deck_gl
  raw_webgl
  native_android

choice interaction_quality one_of
  touching
  settled

public export
record theta_parameters where
  constructor theta_settings
  tau_real : Scalar
  tau_imaginary : Scalar
  alpha : Scalar
  beta : Scalar
  height : height_mode
  color : color_mode

public export
default_theta : theta_parameters
default_theta = theta_settings 0.0 1.0 0.0 0.0 modulus_height wegert_color

public export
resolution : interaction_quality → Nat
resolution touching = 48
resolution settled = 144

public export
record rgb where
  constructor rgb_color
  red : Scalar
  green : Scalar
  blue : Scalar

public export
record vertex where
  constructor surface_vertex
  x : Scalar
  y : Scalar
  z : Scalar
  magnitude : Scalar
  phase : Scalar
  color_value : rgb

public export
record triangle where
  constructor surface_triangle
  first : Nat
  second : Nat
  third : Nat

public export
record surface_frame where
  constructor frame
  columns : Nat
  rows : Nat
  vertices : List vertex
  triangles : List triangle

public export
record camera where
  constructor camera_state
  yaw : Scalar
  pitch : Scalar
  distance : Scalar
  pan_x : Scalar
  pan_y : Scalar

public export
default_camera : camera
default_camera = camera_state 0.65 0.8 3.25 0.0 0.0

choice render_command one_of
  upload_surface surface_frame
  move_camera camera
  resize_view Nat Nat
  present_frame
